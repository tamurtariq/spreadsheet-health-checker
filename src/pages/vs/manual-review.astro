---
import Layout from '../../layouts/Layout.astro';
import ToolsNav from '../../components/ToolsNav.astro';
import '../../styles/components.css';
---

<Layout title="Spreadsheet Health Checker vs Manual Review">
  <main class="main" id="main-content">
    <ToolsNav />
    <header class="compare-header">
      <div class="compare-header-content">
        <p class="eyebrow">Comparison</p>
        <h1>Spreadsheet Health Checker <span class="badge" data-tone="brand">vs</span> Manual Review</h1>
        <p class="tagline">Why automated validation beats hours of eyeballing cells — every time</p>
      </div>
    </header>

    <section class="problem-section">
      <h2>The Problem with Manual Review</h2>
      <div class="problem-grid">
        <article class="problem-card card">
          <div class="problem-icon" aria-hidden="true">⏱️</div>
          <h3>Time Consuming</h3>
          <p>A 10,000-row spreadsheet takes <strong>4-8 hours</strong> to review manually. Our tool does it in <strong>under 10 seconds</strong>.</p>
        </article>
        <article class="problem-card card">
          <div class="problem-icon" aria-hidden="true">👁️</div>
          <h3>Human Error</h3>
          <p>Studies show reviewers miss <strong>30-50%</strong> of formula errors. Fatigue sets in after 30 minutes.</p>
        </article>
        <article class="problem-card card">
          <div class="problem-icon" aria-hidden="true">🔍</div>
          <h3>Invisible Errors</h3>
          <p>Hidden rows, white-on-white text, and off-screen columns are easily missed. Automated tools check every cell.</p>
        </article>
        <article class="problem-card card">
          <div class="problem-icon" aria-hidden="true">🔄</div>
          <h3>No Regression Testing</h3>
          <p>After fixes, manual re-review is rarely done. Automated checks run every time — catching regressions instantly.</p>
        </article>
        <article class="problem-card card">
          <div class="problem-icon" aria-hidden="true">📋</div>
          <h3>Inconsistent Standards</h3>
          <p>Different reviewers check different things. Our 30+ checks run the same way every time.</p>
        </article>
        <article class="problem-card card">
          <div class="problem-icon" aria-hidden="true">📊</div>
          <h3>No Audit Trail</h3>
          <p>Manual reviews leave no evidence. Our reports export to CSV/PDF for compliance and audit trails.</p>
        </article>
      </div>
    </section>

    <section class="roi-section">
      <h2>ROI Calculator</h2>
      <div class="roi-grid">
        <div class="roi-card card">
          <h3>Manual Review Cost</h3>
          <ul>
            <li>Senior analyst: $75/hr</li>
            <li>10K rows = 6 hours avg</li>
            <li><strong>$450 per review</strong></li>
            <li>Monthly = <strong>$5,400</strong></li>
          </ul>
        </div>
        <div class="roi-card card highlight">
          <h3>Automated Cost</h3>
          <ul>
            <li>Pro plan: $9/mo</li>
            <li>Unlimited scans</li>
            <li><strong>$9 per month</strong></li>
            <li>Annual savings: <strong>$64,788</strong></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="what-you-miss">
      <h2>What Manual Review Misses (That We Catch)</h2>
      <div class="miss-grid">
        <div class="miss-category card">
          <h3>Formula Errors</h3>
          <ul>
            <li>Circular references (entire chains)</li>
            <li>Inconsistent formulas across rows</li>
            <li>Volatile functions (INDIRECT, OFFSET)</li>
            <li>Large range references (>10K cells)</li>
            <li>All error types: #REF!, #DIV/0!, #VALUE!, #NAME?, #N/A, #NUM!, #NULL!, #CALC!, #SPILL!</li>
          </ul>
        </div>
        <div class="miss-category card">
          <h3>Data Quality</h3>
          <ul>
            <li>Mixed types in single columns</li>
            <li>Numbers stored as text (silent SUM killer)</li>
            <li>Duplicate lookup keys</li>
            <li>Leading/trailing/multiple spaces</li>
            <li>Blank row/column clusters</li>
          </ul>
        </div>
        <div class="miss-category card">
          <h3>Structure</h3>
          <ul>
            <li>Hidden rows/columns with data</li>
            <li>Oversized sheets (>10K rows, >200 cols)</li>
            <li>Trailing empty rows/columns</li>
            <li>Empty header rows</li>
            <li>Orphaned named ranges</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="workflow-section">
      <h2>Workflow Comparison</h2>
      <div class="workflow-comparison">
        <div class="workflow-column card">
          <h3>Manual Review Process</h3>
          <ol>
            <li>Open workbook, scan tabs</li>
            <li>Check each sheet for errors</li>
            <li>Trace precedents/dependents</li>
            <li>Verify formula consistency</li>
            <li>Check data types column-by-column</li>
            <li>Look for hidden data</li>
            <li>Document findings in separate doc</li>
            <li>Share with team, track fixes</li>
            <li>Re-review after fixes</li>
          </ol>
          <div class="time-badge">4-8 hours</div>
        </div>
        <div class="workflow-column card highlight">
          <h3>Spreadsheet Health Checker</h3>
          <ol>
            <li>Drag & drop file</li>
            <li>Click "Analyze"</li>
            <li>Review prioritized findings</li>
            <li>Export CSV/PDF for team</li>
            <li>Fix issues</li>
            <li>Re-run (seconds)</li>
          </ol>
          <div class="time-badge">30 seconds</div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <h2>Stop Eyeballing. Start Validating.</h2>
      <p>Free tier: 3 scans/month. Pro: $9/mo unlimited.</p>
      <a href="/spreadsheet-health-checker" class="btn btn-primary btn-lg">Try Free Analysis</a>
    </section>
  </main>

  <style>
    .main { min-height: 100vh; }

    .compare-header {
      padding: var(--space-16) var(--space-8) var(--space-10);
      text-align: center;
    }

    .compare-header-content { max-width: 760px; margin: 0 auto; }

    .eyebrow {
      margin: 0 0 var(--space-3);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brand-500);
    }

    .compare-header h1 { font-size: var(--text-4xl); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 var(--space-4); color: var(--color-text); }
    .compare-header .badge { vertical-align: middle; text-transform: uppercase; }
    .tagline { font-size: var(--text-lg); color: var(--color-text-muted); margin: 0; line-height: 1.6; }

    .problem-section {
      max-width: 1000px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-8) var(--space-4);
    }

    .problem-section h2 { font-size: var(--text-2xl); margin-bottom: var(--space-8); color: var(--color-text); text-align: center; }

    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-5);
    }

    .problem-card { padding: var(--space-6); text-align: center; }

    .problem-icon { font-size: 2.25rem; margin-bottom: var(--space-3); }
    .problem-card h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); color: var(--color-text); }
    .problem-card p { margin: 0; color: var(--color-text-secondary); line-height: 1.6; }
    .problem-card strong { color: var(--color-danger); }

    .roi-section {
      max-width: 1000px;
      margin: 0 auto var(--space-16);
      padding: var(--space-4) var(--space-8);
    }

    .roi-section h2 { font-size: var(--text-2xl); margin-bottom: var(--space-8); color: var(--color-text); text-align: center; }

    .roi-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }

    .roi-card { padding: var(--space-8); }

    .roi-card.highlight {
      border-color: var(--brand-500);
      background: var(--brand-bg-subtle);
    }

    .roi-card h3 { margin: 0 0 var(--space-4); font-size: var(--text-xl); color: var(--color-text); }
    .roi-card ul { margin: 0; padding-left: 1.25rem; }
    .roi-card li { margin: 0.5rem 0; color: var(--color-text-secondary); }
    .roi-card strong { color: var(--color-text); font-size: var(--text-lg); }

    .what-you-miss {
      max-width: 1000px;
      margin: 0 auto var(--space-16);
      padding: var(--space-4) var(--space-8);
    }

    .what-you-miss h2 { font-size: var(--text-2xl); margin-bottom: var(--space-8); color: var(--color-text); text-align: center; }

    .miss-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-5);
    }

    .miss-category { padding: var(--space-6); }

    .miss-category h3 { margin: 0 0 var(--space-4); font-size: var(--text-lg); color: var(--color-text); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
    .miss-category ul { margin: 0; padding-left: 1.25rem; }
    .miss-category li { margin: 0.375rem 0; color: var(--color-text-secondary); font-size: var(--text-sm); }

    .workflow-section {
      max-width: 1000px;
      margin: 0 auto var(--space-16);
      padding: var(--space-4) var(--space-8);
    }

    .workflow-section h2 { font-size: var(--text-2xl); margin-bottom: var(--space-8); color: var(--color-text); text-align: center; }

    .workflow-comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .workflow-column { padding: var(--space-8); }

    .workflow-column.highlight {
      border-color: var(--brand-500);
      background: var(--brand-bg-subtle);
    }

    .workflow-column h3 { margin: 0 0 var(--space-5); font-size: var(--text-xl); color: var(--color-text); }
    .workflow-column ol { margin: 0; padding-left: 1.25rem; }
    .workflow-column li { margin: 0.75rem 0; color: var(--color-text-secondary); line-height: 1.5; }

    .time-badge {
      display: inline-block;
      margin-top: var(--space-5);
      padding: 0.625rem var(--space-5);
      background: var(--gray-100);
      color: var(--color-text-secondary);
      border-radius: var(--radius-full);
      font-weight: 600;
      font-size: var(--text-lg);
    }

    .workflow-column.highlight .time-badge {
      background: var(--brand-500);
      color: white;
    }

    .cta-section {
      text-align: center;
      padding: var(--space-16) var(--space-8);
      background: var(--color-bg-subtle);
      border-top: 1px solid var(--color-border);
    }

    .cta-section h2 { font-size: var(--text-3xl); margin: 0 0 var(--space-3); color: var(--color-text); }
    .cta-section p { color: var(--color-text-muted); margin: 0 0 var(--space-8); font-size: var(--text-lg); }

    @media (max-width: 768px) {
      .compare-header h1 { font-size: var(--text-2xl); }
      .roi-grid { grid-template-columns: 1fr; }
      .workflow-comparison { grid-template-columns: 1fr; }
      .problem-section, .roi-section, .what-you-miss, .workflow-section { padding-left: var(--space-4); padding-right: var(--space-4); }
    }
  </style>
</Layout>