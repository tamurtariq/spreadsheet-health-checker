---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog', ({ data }) => {
  return data.pubDate <= new Date();
});

const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog - FOVIQ Tools">
  <main class="main" id="main-content">
    <header class="blog-header">
      <div class="blog-header-content">
        <h1>Spreadsheet Health Checker Blog</h1>
        <p>Tips, guides, and best practices for spreadsheet validation, data quality, and error prevention.</p>
      </div>
    </header>

    <section class="blog-grid">
      {sortedPosts.map(post => (
        <article class="blog-card">
          <div class="blog-card-content">
            <div class="blog-meta">
              <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
              <span class="tags">{post.data.tags.join(' · ')}</span>
            </div>
            <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <a href={`/blog/${post.slug}`} class="read-more">Read more →</a>
          </div>
        </article>
      ))}
    </section>

    <footer class="blog-footer">
      <p>Want to validate your spreadsheets? <a href="/dashboard">Try Spreadsheet Health Checker free</a>.</p>
    </footer>
  </main>

  <style>
    .main { min-height: 100vh; }
    
    .blog-header {
      background: var(--color-bg-subtle);
      padding: 4rem 2rem;
      text-align: center;
      border-bottom: 1px solid var(--color-border);
    }
    
    .blog-header-content { max-width: 800px; margin: 0 auto; }
    .blog-header h1 { font-size: 2.5rem; margin: 0 0 1rem; color: var(--color-text); }
    .blog-header p { font-size: 1.125rem; color: var(--color-text-muted); margin: 0; }
    
    .blog-grid {
      max-width: 900px;
      margin: 3rem auto;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    
    .blog-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      overflow: hidden;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    
    .blog-card:hover {
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
      transform: translateY(-2px);
    }
    
    .blog-card-content { padding: 1.5rem; }
    
    .blog-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.875rem;
      color: var(--color-text-faint);
      margin-bottom: 0.75rem;
    }
    
    .blog-meta time { font-weight: 500; color: var(--color-text-muted); }
    .tags { color: var(--brand-500); }
    
    .blog-card h2 { margin: 0 0 0.75rem; font-size: 1.375rem; line-height: 1.3; }
    .blog-card h2 a { color: var(--color-text); text-decoration: none; }
    .blog-card h2 a:hover { color: var(--brand-500); }
    
    .blog-card p { margin: 0 0 1rem; color: var(--color-text-secondary); line-height: 1.6; }
    
    .read-more {
      display: inline-block;
      color: var(--brand-500);
      font-weight: 500;
      text-decoration: none;
    }
    .read-more:hover { text-decoration: underline; }
    
    .blog-footer {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--color-text-muted);
    }
    .blog-footer a { color: var(--brand-500); font-weight: 500; }
    
    @media (max-width: 768px) {
      .blog-header { padding: 2rem 1rem; }
      .blog-header h1 { font-size: 1.75rem; }
      .blog-grid { gap: 1.5rem; }
    }
  </style>
</Layout>