---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToolsNav from '../../components/ToolsNav.astro';
import '../../styles/components.css';

// This project renders in `output: "server"` mode (see CLAUDE.md), where
// getStaticPaths() is ignored for dynamic routes - it only wires up
// Astro.props on prerendered/static routes. Look the post up directly from
// the request's slug param instead of relying on getStaticPaths' props,
// which were silently undefined at request time and 500'd every post.
//
// Individual posts are listed in the sitemap via `customPages` in
// astro.config.mjs rather than by prerendering this route: setting
// `prerender = true` here makes @astrojs/cloudflare's build-time
// prerenderer spin up a real remote connection for the KV/D1 bindings
// (`remote: true` in wrangler.jsonc), which needs a CLOUDFLARE_API_TOKEN
// and fails in plain `astro build` without one.
//
// Entries come from the `glob()` content-layer loader (src/content.config.ts),
// which keys collections by `.id` (the slugified filename) - there is no
// `.slug` field, so matching against it here (and linking with it from
// blog/index.astro) always resolved to `undefined`.
const { slug } = Astro.params;
const posts = await getCollection('blog');
const post = posts.find(p => p.id === slug);

if (!post) {
  return Astro.rewrite('/404');
}

const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <ToolsNav />
  <article class="main" id="main-content">
    <header class="post-header">
      <div class="post-meta">
        <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {post.data.updatedDate && <span>Updated {post.data.updatedDate.toLocaleDateString()}</span>}
        <div class="tags">
          {post.data.tags.map(tag => <span class="badge" data-tone="brand">{tag}</span>)}
        </div>
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <hr />
      <p>Ready to validate your spreadsheets? <a href="/spreadsheet-health-checker">Try Spreadsheet Health Checker free</a>.</p>
      <p><a href="/blog">← Back to Blog</a></p>
    </footer>
  </article>

  <style>
    .main { max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; }
    
    .post-header { margin-bottom: 3rem; }
    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.875rem;
      color: var(--color-text-faint);
      margin-bottom: 1rem;
    }
    .post-meta time { font-weight: 500; color: var(--color-text-muted); }
    .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }

    h1 { font-size: 2.5rem; line-height: 1.2; margin: 0 0 1rem; color: var(--color-text); }
    .post-description { font-size: 1.25rem; color: var(--color-text-muted); margin: 0; }
    
    .post-content { line-height: 1.8; color: var(--color-text-secondary); }
    .post-content h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; color: var(--color-text); }
    .post-content h3 { font-size: 1.25rem; margin: 2rem 0 0.75rem; color: var(--color-text); }
    .post-content p { margin: 1rem 0; }
    .post-content ul, .post-content ol { margin: 1rem 0; padding-left: 1.5rem; }
    .post-content li { margin: 0.5rem 0; }
    .post-content a { color: var(--brand-500); text-decoration: none; }
    .post-content a:hover { text-decoration: underline; }
    .post-content code { background: var(--gray-100); padding: 0.125rem 0.375rem; border-radius: 4px; font-size: 0.9em; }
    .post-content pre { background: var(--gray-900); color: var(--gray-200); padding: 1.5rem; border-radius: 8px; overflow-x: auto; margin: 1.5rem 0; }
    .post-content pre code { background: none; padding: 0; font-size: 0.875rem; }
    .post-content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
    .post-content th, .post-content td { border: 1px solid var(--color-border); padding: 0.75rem; text-align: left; }
    .post-content th { background: var(--color-bg-subtle); font-weight: 600; }
    .post-content tr:nth-child(even) { background: var(--color-bg-subtle); }
    .post-content blockquote { border-left: 4px solid var(--brand-500); padding-left: 1rem; margin: 1.5rem 0; color: var(--color-text-muted); font-style: italic; }
    
    .post-footer {
      margin-top: 3rem;
      padding-top: 2rem;
      color: var(--color-text-muted);
    }
    .post-footer a { color: var(--brand-500); font-weight: 500; }
    
    @media (max-width: 768px) {
      .main { padding: 2rem 1rem; }
      h1 { font-size: 1.75rem; }
    }
  </style>
</Layout>