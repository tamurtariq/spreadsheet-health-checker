---
import Layout from '../../layouts/Layout.astro';
import DiffChecker from '../../components/DiffChecker.tsx';
import ToolsNav from '../../components/ToolsNav.astro';
---

<Layout title="Diff Checker - FOVIQ Tools">
  <main class="main">
    <header class="diff-header">
      <ToolsNav theme="light" />
    </header>

    <div class="diff-page">
      <DiffChecker 
        client:load
        limits={{ diffChecker: false, maxFileSizeMB: 50 }}
      />
    </div>
  </main>

  <style>
    .main { min-height: 100vh; display: flex; flex-direction: column; }

    .diff-header {
      border-bottom: 1px solid #e5e7eb;
      background: white;
    }

    .diff-page {
      flex: 1;
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }

    @media (max-width: 768px) {
      .diff-page { padding: 1rem; }
    }
  </style>
</Layout>