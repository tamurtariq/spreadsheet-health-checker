---
import Layout from '../../layouts/Layout.astro';
import DiffChecker from '../../components/DiffChecker.tsx';
---

<Layout title="Diff Checker - Spreadsheet Health Checker">
  <main class="main">
    <header class="diff-header">
      <nav class="nav-bar">
        <a href="/" class="logo">Spreadsheet Health Checker</a>
        <div id="nav-auth" class="nav-auth">
          <a href="/login" class="btn btn-secondary">Sign In</a>
          <a href="/login" class="btn btn-primary">Get Started Free</a>
        </div>
      </nav>
    </header>

    <div class="diff-page">
      <DiffChecker 
        client:load
        limits={{ diffChecker: false, maxFileSizeMB: 50 }}
      />
    </div>
  </main>

  <script>
    async function loadAuth() {
      try {
        const res = await fetch('/api/auth/me', { credentials: 'include' });
        const data = await res.json();
        const navAuth = document.getElementById('nav-auth');
        
        if (data.user) {
          navAuth.innerHTML = `
            <div class="user-menu">
              <span class="user-email">${data.user.email}</span>
              <a href="/dashboard" class="btn btn-primary">Dashboard</a>
              <button id="logout-btn" class="btn btn-secondary btn-logout">Logout</button>
            </div>
          `;
          document.getElementById('logout-btn')?.addEventListener('click', async () => {
            await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
            window.location.reload();
          });
        }
      } catch (error) {
        console.error('Auth check failed:', error);
      }
    }
    loadAuth();
  </script>

  <style>
    .main { min-height: 100vh; display: flex; flex-direction: column; }
    
    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    
    .logo {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1f2937;
      text-decoration: none;
    }
    
    .nav-auth { display: flex; gap: 0.75rem; }
    
    .btn {
      padding: 0.5rem 1.25rem;
      border-radius: 8px;
      font-weight: 500;
      text-decoration: none;
      font-size: 0.875rem;
      transition: all 0.2s;
    }
    
    .btn-primary {
      background: #667eea;
      color: white;
    }
    .btn-primary:hover { background: #5a6fd6; }
    
    .btn-secondary {
      background: #f3f4f6;
      color: #374151;
      border: 1px solid #e5e7eb;
    }
    .btn-secondary:hover { background: #e5e7eb; }
    
    .user-menu { display: flex; align-items: center; gap: 1rem; }
    .user-email { color: #6b7280; font-size: 0.875rem; }
    .btn-logout {
      background: #fef2f2;
      color: #ef4444;
      border: 1px solid #fecaca;
    }
    .btn-logout:hover { background: #fee2e2; }
    
    .diff-header {
      border-bottom: 1px solid #e5e7eb;
      background: white;
    }
    
    .diff-page {
      flex: 1;
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    
    @media (max-width: 768px) {
      .nav-bar { flex-direction: column; gap: 1rem; }
      .diff-page { padding: 1rem; }
    }
  </style>
</Layout>