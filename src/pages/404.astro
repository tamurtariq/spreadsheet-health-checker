---
import Layout from '../layouts/Layout.astro';
import ToolsNav from '../components/ToolsNav.astro';
import '../styles/components.css';
---

<Layout title="Page Not Found - FOVIQ Tools" description="The page you're looking for doesn't exist.">
  <main class="main" id="main-content">
    <ToolsNav />
    <div class="not-found">
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p>The page you're looking for doesn't exist or may have moved.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary btn-lg">Go to Homepage</a>
        <a href="/dashboard" class="btn btn-secondary btn-lg">Go to Dashboard</a>
      </div>
    </div>
  </main>

  <style>
    .main {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .not-found {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--space-8) var(--space-4);
    }

    .code {
      margin: 0;
      font-size: var(--text-5xl);
      font-weight: 800;
      background: var(--brand-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .not-found h1 {
      margin: var(--space-2) 0 var(--space-2);
      font-size: var(--text-2xl);
      color: var(--color-text);
    }

    .not-found p {
      margin: 0 0 var(--space-6);
      color: var(--color-text-muted);
      max-width: 32rem;
    }

    .actions {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      justify-content: center;
    }
  </style>
</Layout>
