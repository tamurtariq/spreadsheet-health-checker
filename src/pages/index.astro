---
import Layout from '../layouts/Layout.astro';
import ToolsNav from '../components/ToolsNav.astro';
import '../styles/components.css';

const TOOLS = [
  {
    href: '/spreadsheet-health-checker',
    name: 'Spreadsheet Health Checker',
    description: 'Scan CSV/XLSX files for formula errors, data-quality issues, and structural problems, and get a scored health report.',
    tag: 'Free',
    icon: 'M9 11H3v10h6zM21 3h-6v18h6zM15 7H9v14h6z',
  },
  {
    href: '/diff',
    name: 'Diff Checker',
    description: 'Compare two spreadsheet versions cell-by-cell, including formula changes, and see exactly what moved.',
    tag: 'Pro',
    icon: 'M17 3v18M7 3v18M3 8h4M3 16h4M17 8h4M17 16h4',
  },
  {
    href: '/lead-csv-cleaner',
    name: 'Lead CSV Cleaner',
    description: 'Validate, normalize, and deduplicate lead lists so they import cleanly into your CRM.',
    tag: 'Free',
    icon: 'M20 6 9 17l-5-5',
  },
];

const TRUST = [
  { title: 'Client-side by design', body: 'Files are processed in your browser. Nothing is uploaded to a server.' },
  { title: 'Instant results', body: 'No queues, no processing wait — analysis runs the moment you drop a file.' },
  { title: 'Works with your files', body: 'Native support for CSV and Excel (.xlsx) workbooks, no conversion needed.' },
];
---

<Layout title="FOVIQ Tools — Practical tools for your spreadsheets">
  <meta name="google-site-verification" content="lzgnJVpNBXxPeYzWCCJxUccV_8Znnw_Zry14PDS_jvg" slot="head" />
  <main class="main" id="main-content">
    <ToolsNav />

    <header class="hero">
      <p class="eyebrow">FOVIQ Tools</p>
      <h1>Practical, privacy-first tools for your spreadsheets</h1>
      <p class="tagline">Clean, validate, and compare your data — entirely in your browser. No uploads, no waiting, no signup required to start.</p>
      <div class="hero-cta">
        <a href="/spreadsheet-health-checker" class="btn btn-primary btn-lg">
          Try Health Checker Free
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="/blog" class="btn btn-secondary btn-lg">Read the blog</a>
      </div>
    </header>

    <section class="tools-section" aria-labelledby="tools-heading">
      <h2 id="tools-heading">Tools</h2>
      <div class="tools-grid">
        {TOOLS.map(tool => (
          <a href={tool.href} class="tool-card card card-interactive">
            <div class="tool-card-top">
              <span class="tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={tool.icon} /></svg>
              </span>
              <span class="badge" data-tone={tool.tag === 'Pro' ? 'warning' : 'success'}>{tool.tag}</span>
            </div>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            <span class="tool-card-link">Open tool
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="trust-section" aria-labelledby="trust-heading">
      <h2 id="trust-heading" class="sr-only">Why FOVIQ Tools</h2>
      <div class="trust-grid">
        {TRUST.map(item => (
          <div class="trust-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <style>
    .main {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .hero {
      max-width: 720px;
      margin: 0 auto;
      padding: var(--space-16) var(--space-8) var(--space-12);
      text-align: center;
    }

    .eyebrow {
      margin: 0 0 var(--space-3);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brand-500);
    }

    .hero h1 {
      margin: 0 0 var(--space-5);
      font-size: var(--text-5xl);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.1;
      color: var(--color-text);
    }

    .tagline {
      margin: 0 auto var(--space-8);
      font-size: var(--text-lg);
      color: var(--color-text-muted);
      line-height: 1.6;
      max-width: 540px;
    }

    .hero-cta {
      display: flex;
      gap: var(--space-3);
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-cta svg {
      width: 18px;
      height: 18px;
    }

    .tools-section {
      max-width: 1080px;
      margin: 0 auto;
      width: 100%;
      padding: var(--space-8) var(--space-8) var(--space-4);
    }

    .tools-section h2 {
      margin: 0 0 var(--space-6);
      font-size: var(--text-sm);
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-text-faint);
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-5);
    }

    .tool-card {
      display: flex;
      flex-direction: column;
      padding: var(--space-6);
      text-decoration: none;
      color: inherit;
    }

    .tool-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-4);
    }

    .tool-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-lg);
      background: var(--brand-tag-bg);
      color: var(--brand-500);
    }

    .tool-icon svg {
      width: 20px;
      height: 20px;
    }

    .tool-card h3 {
      margin: 0 0 var(--space-2);
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--color-text);
    }

    .tool-card p {
      margin: 0;
      flex: 1;
      color: var(--color-text-muted);
      line-height: 1.6;
      font-size: var(--text-sm);
    }

    .tool-card-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-5);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--brand-500);
    }

    .tool-card-link svg {
      width: 16px;
      height: 16px;
      transition: transform var(--transition-base);
    }

    .tool-card:hover .tool-card-link svg {
      transform: translateX(3px);
    }

    .trust-section {
      max-width: 1080px;
      margin: 0 auto;
      width: 100%;
      padding: var(--space-12) var(--space-8) var(--space-16);
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--space-8);
      padding-top: var(--space-10);
      border-top: 1px solid var(--color-border);
    }

    .trust-item h3 {
      margin: 0 0 var(--space-2);
      font-size: var(--text-base);
      font-weight: 700;
      color: var(--color-text);
    }

    .trust-item p {
      margin: 0;
      color: var(--color-text-muted);
      line-height: 1.6;
      font-size: var(--text-sm);
    }

    @media (max-width: 768px) {
      .hero { padding: var(--space-12) var(--space-4) var(--space-8); }
      .hero h1 { font-size: var(--text-3xl); }
      .tagline { font-size: var(--text-base); }
      .tools-section, .trust-section { padding-left: var(--space-4); padding-right: var(--space-4); }
    }
  </style>
</Layout>
