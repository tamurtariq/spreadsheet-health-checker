---
import Layout from '../layouts/Layout.astro';
import Analyzer from '../components/Analyzer.tsx';
import ToolsNav from '../components/ToolsNav.astro';
---

<Layout title="FOVIQ Tools">
  <meta name="google-site-verification" content="lzgnJVpNBXxPeYzWCCJxUccV_8Znnw_Zry14PDS_jvg" slot="head" />
  <main class="main" id="main-content">
    <header class="hero">
      <ToolsNav theme="hero" />
      <div class="hero-content">
        <h1>Spreadsheet Health Checker</h1>
        <p class="tagline">Validate your spreadsheets for formula errors, data quality issues, and structural problems — 100% client-side, zero data upload.</p>
        <div class="hero-badges">
          <span class="badge"><span aria-hidden="true">🔒</span> Privacy First</span>
          <span class="badge"><span aria-hidden="true">⚡</span> Instant Results</span>
          <span class="badge"><span aria-hidden="true">📊</span> CSV & Excel</span>
        </div>
        <div class="hero-cta">
          <a href="#analyzer" class="btn btn-primary btn-large">
            Try It Free
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </a>
        </div>
      </div>
    </header>

    <div class="analyzer-section" id="analyzer">
      <Analyzer client:load />
    </div>

    <section class="features">
      <div class="feature">
        <div class="feature-icon" aria-hidden="true">🔍</div>
        <h3>Formula Validation</h3>
        <p>Detects #REF!, #DIV/0!, #VALUE!, circular references, inconsistent formulas, and volatile functions.</p>
      </div>
      <div class="feature">
        <div class="feature-icon" aria-hidden="true">📋</div>
        <h3>Data Quality Checks</h3>
        <p>Identifies mixed types, numbers stored as text, duplicate keys, whitespace anomalies, and blank clusters.</p>
      </div>
      <div class="feature">
        <div class="feature-icon" aria-hidden="true">🏗️</div>
        <h3>Structure Analysis</h3>
        <p>Finds hidden rows/columns with data, oversized sheets, trailing empty rows/columns, and sparse data.</p>
      </div>
    </section>
  </main>

  <style>
    .main {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    .hero {
      padding: 3rem 2rem 2.5rem;
      text-align: center;
      background: linear-gradient(135deg, var(--brand-500) 0%, var(--brand-700) 100%);
      color: white;
    }
    
    .hero-content {
      max-width: 800px;
      margin: 0 auto;
    }
    
    .hero h1 {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }
    
    .tagline {
      font-size: 1.25rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto 2rem;
      line-height: 1.6;
    }
    
    .hero-badges {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .badge {
      background: rgba(255,255,255,0.2);
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      backdrop-filter: blur(4px);
    }
    
    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      padding: 4rem 2rem;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
    }
    
    .feature {
      padding: 2rem;
      background: var(--color-surface);
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
      text-align: center;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .feature:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }
    
    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    
    .feature h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }
    
    .feature p {
      color: var(--color-text-muted);
      line-height: 1.6;
    }
    
    .analyzer-section {
      flex: 1;
      padding: 2rem;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem;
      border-radius: var(--radius-lg);
      font-weight: 600;
      text-decoration: none;
      font-size: 0.875rem;
      transition: transform var(--transition-base), box-shadow var(--transition-base), background var(--transition-base);
    }

    .btn:active {
      transform: translateY(0) scale(0.97);
    }

    .btn-primary {
      background: var(--color-surface);
      color: var(--brand-500);
      box-shadow: var(--shadow-md);
    }
    .btn-primary:hover {
      background: var(--gray-100);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .btn-large {
      padding: 1rem 2.25rem;
      font-size: 1.125rem;
    }

    .btn-large svg {
      width: 20px;
      height: 20px;
      animation: bounce-down 2s ease-in-out infinite;
    }

    @keyframes bounce-down {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(3px); }
    }

    .hero-cta { margin-top: 1.75rem; }

    .analyzer-section { max-width: 800px; scroll-margin-top: 1.5rem; }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .tagline { font-size: 1rem; }
      .features { grid-template-columns: 1fr; }
      .hero-cta { margin-top: 1rem; }
    }
  </style>
</Layout>