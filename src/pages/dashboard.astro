---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard - Spreadsheet Health Checker">
  <main class="main">
    <header class="dashboard-header">
      <div class="header-content">
        <h1>Dashboard</h1>
        <div class="user-menu">
          <span id="user-email" class="user-email"></span>
          <a href="/email-prefs" class="prefs-link">Email Preferences</a>
          <button id="logout-btn" class="logout-btn">Logout</button>
        </div>
      </div>
    </header>

    <div class="dashboard-grid">
      <section class="card subscription-card">
        <h2>Subscription</h2>
        <div class="tier-badge" id="tier-badge">Free</div>
        <p id="subscription-status" class="status">Active</p>
        <div class="limits" id="limits">
          <div class="limit-item">
            <span class="limit-label">Scans/month</span>
            <span class="limit-value" id="scans-limit">3</span>
          </div>
          <div class="limit-item">
            <span class="limit-label">Max file size</span>
            <span class="limit-value" id="file-size-limit">5 MB</span>
          </div>
          <div class="limit-item">
            <span class="limit-label">Diff checker</span>
            <span class="limit-value" id="diff-checker">No</span>
          </div>
          <div class="limit-item">
            <span class="limit-label">PDF export</span>
            <span class="limit-value" id="pdf-export">No</span>
          </div>
        </div>
        <button id="upgrade-btn" class="upgrade-btn">Upgrade to Pro</button>
      </section>

      <section class="card usage-card">
        <h2>Usage This Month</h2>
        <div class="usage-bar">
          <div class="usage-fill" id="usage-fill" style="width: 0%"></div>
        </div>
        <div class="usage-stats">
          <span id="scans-used">0</span> / <span id="scans-remaining">3</span> scans used
        </div>
        <p class="reset-info">Resets on the 1st of each month</p>
      </section>

      <section class="card analyzer-card">
        <h2>Spreadsheet Analyzer</h2>
        <p>Upload a spreadsheet to check its health</p>
        <div id="analyzer-container"></div>
      </section>

      <section class="card api-keys-card" id="api-keys-card" style="display: none;">
        <div class="card-header">
          <h2>API Keys</h2>
          <button id="create-api-key-btn" class="btn btn-primary btn-sm">Create Key</button>
        </div>
        <div id="api-keys-list" class="api-keys-list">
          <p class="loading">Loading...</p>
        </div>
      </section>

      <section class="card team-card" id="team-card" style="display: none;">
        <div class="card-header">
          <h2>Team Members</h2>
          <button id="invite-member-btn" class="btn btn-primary btn-sm">Invite Member</button>
        </div>
        <div id="team-members-list" class="team-members-list">
          <p class="loading">Loading...</p>
        </div>
      </section>
    </div>
  </main>

  <script>
    async function loadAuth() {
      try {
        const res = await fetch('/api/auth/me', { credentials: 'include' });
        const data = await res.json();
        
        if (!data.user) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('user-email')!.textContent = data.user.email;
        document.getElementById('tier-badge')!.textContent = data.subscription.tier.charAt(0).toUpperCase() + data.subscription.tier.slice(1);
        document.getElementById('subscription-status')!.textContent = data.subscription.status;
        document.getElementById('scans-limit')!.textContent = data.limits.scansPerMonth === -1 ? 'Unlimited' : data.limits.scansPerMonth;
        document.getElementById('file-size-limit')!.textContent = data.limits.maxFileSizeMB + ' MB';
        document.getElementById('diff-checker')!.textContent = data.limits.diffChecker ? 'Yes' : 'No';
        document.getElementById('pdf-export')!.textContent = data.limits.pdfExport ? 'Yes' : 'No';
        
        const used = data.usage.scansUsed;
        const limit = data.limits.scansPerMonth;
        const remaining = data.usage.scansRemaining;
        
        document.getElementById('scans-used')!.textContent = used;
        document.getElementById('scans-remaining')!.textContent = limit === -1 ? 'Unlimited' : remaining;
        
        if (limit !== -1) {
          const percent = (used / limit) * 100;
          document.getElementById('usage-fill')!.style.width = Math.min(100, percent) + '%';
        } else {
          document.getElementById('usage-fill')!.style.width = '0%';
          document.getElementById('usage-fill')!.style.background = 'linear-gradient(90deg, #22c55e, #16a34a)';
        }
        
        if (data.subscription.tier === 'free') {
          document.getElementById('upgrade-btn')!.style.display = 'block';
        }
        
        loadAnalyzer(data.limits, data.usage.scansUsed, data.usage.scansRemaining);
      } catch (error) {
        console.error('Auth load failed:', error);
        window.location.href = '/login';
      }
    }
    
    function loadAnalyzer(limits: any, scansUsed: number, scansRemaining: number) {
      const container = document.getElementById('analyzer-container');
      if (!container) return;
      
      import('../components/Analyzer.tsx').then(module => {
        const Analyzer = module.default;
        const root = document.createElement('div');
        container.appendChild(root);
        
        if (window.React && window.ReactDOM) {
          window.ReactDOM.createRoot(root).render(window.React.createElement(Analyzer, { 
            limits, 
            scansUsed,
            scansRemaining,
            maxFileSize: limits.maxFileSizeMB * 1024 * 1024 
          }));
        }
      });
    }
    
    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      window.location.href = '/';
    });
    
    document.getElementById('upgrade-btn')!.addEventListener('click', () => {
      alert('Upgrade flow coming soon (Lemon Squeezy integration)');
    });
    
    loadAuth();
    
    async function loadApiKeys() {
      try {
        const res = await fetch('/api/api-keys', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        renderApiKeys(data.keys);
      } catch (error) {
        console.error('Failed to load API keys:', error);
      }
    }
    
    function renderApiKeys(keys: any[]) {
      const list = document.getElementById('api-keys-list');
      const card = document.getElementById('api-keys-card');
      
      if (!card) return;
      
      card.style.display = 'block';
      
      if (!keys || keys.length === 0) {
        list.innerHTML = `
          <p class="empty-state">No API keys yet. Create one to access the API.</p>
        `;
        return;
      }
      
      list.innerHTML = keys.map(key => `
        <div class="api-key-item">
          <div class="api-key-info">
            <div class="api-key-name">${key.name}</div>
            <div class="api-key-meta">
              <span class="api-key-prefix">${key.prefix}...</span>
              <span class="api-key-rate-limit">${key.rateLimit} req/min</span>
              <span class="api-key-created">Created ${new Date(key.createdAt).toLocaleDateString()}</span>
            </div>
          </div>
          <button class="btn btn-danger btn-sm delete-key-btn" data-key-id="${key.id}">Delete</button>
        </div>
      `).join('');
      
      list.querySelectorAll('.delete-key-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const keyId = (e.target as HTMLButtonElement).dataset.keyId;
          if (confirm('Delete this API key? This cannot be undone.')) {
            await fetch(`/api/api-keys/${keyId}`, { 
              method: 'DELETE', 
              credentials: 'include' 
            });
            loadApiKeys();
          }
        });
      });
    }
    
    async function loadTeam() {
      try {
        const res = await fetch('/api/teams', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        renderTeam(data);
      } catch (error) {
        console.error('Failed to load team:', error);
      }
    }
    
    function renderTeam(data: any) {
      const list = document.getElementById('team-members-list');
      const card = document.getElementById('team-card');
      
      if (!card) return;
      
      if (!data.team) {
        card.style.display = 'none';
        return;
      }
      
      card.style.display = 'block';
      card.querySelector('h2')!.textContent = `Team (${data.team.role === 'owner' ? 'Owner' : data.team.role === 'admin' ? 'Admin' : 'Member'})`;
      
      if (!data.members || data.members.length === 0) {
        list.innerHTML = '<p class="empty-state">No team members yet.</p>';
        return;
      }
      
      list.innerHTML = data.members.map((member: any) => `
        <div class="team-member-item">
          <div class="team-member-info">
            <div class="team-member-email">${member.email}</div>
            <div class="team-member-meta">
              <span class="team-member-role role-${member.role}">${member.role}</span>
              <span class="team-member-status status-${member.status}">${member.status}</span>
              ${member.acceptedAt ? `<span>Joined ${new Date(member.acceptedAt).toLocaleDateString()}</span>` : '<span>Invited</span>'}
            </div>
          </div>
          <div class="team-member-actions">
            ${data.team.role === 'owner' && member.status === 'active' && member.userId ? `
              <select class="role-select" data-member-id="${member.id}">
                <option value="admin" ${member.role === 'admin' ? 'selected' : ''}>Admin</option>
                <option value="member" ${member.role === 'member' ? 'selected' : ''}>Member</option>
              </select>
              <button class="btn btn-danger btn-sm remove-member-btn" data-member-id="${member.id}">Remove</button>
            ` : ''}
          </div>
        </div>
      `).join('');
      
      list.querySelectorAll('.role-select').forEach(select => {
        select.addEventListener('change', async (e) => {
          const memberId = (e.target as HTMLSelectElement).dataset.memberId;
          const role = (e.target as HTMLSelectElement).value;
          await fetch(`/api/teams/${memberId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ role }),
          });
          loadTeam();
        });
      });
      
      list.querySelectorAll('.remove-member-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const memberId = (e.target as HTMLButtonElement).dataset.memberId;
          if (confirm('Remove this team member?')) {
            await fetch(`/api/teams/${memberId}`, { 
              method: 'DELETE', 
              credentials: 'include' 
            });
            loadTeam();
          }
        });
      });
    }
    
    document.getElementById('create-api-key-btn')!.addEventListener('click', async () => {
      const name = prompt('Enter a name for this API key:');
      if (!name) return;
      
      try {
        const res = await fetch('/api/api-keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ name }),
        });
        
        const data = await res.json();
        if (res.ok) {
          alert(`API Key created! Save this key - you won't see it again:\n\n${data.key}`);
          loadApiKeys();
        } else {
          alert(`Error: ${data.error || 'Failed to create key'}`);
        }
      } catch (error) {
        alert('Failed to create API key');
      }
    });
    
    document.getElementById('invite-member-btn')!.addEventListener('click', async () => {
      const email = prompt('Enter email to invite:');
      if (!email) return;
      
      const role = confirm('Make them an admin?') ? 'admin' : 'member';
      
      try {
        const res = await fetch('/api/teams', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email, role }),
        });
        
        const data = await res.json();
        if (res.ok) {
          alert(`Invitation sent to ${email}!`);
          loadTeam();
        } else {
          alert(`Error: ${data.error || 'Failed to invite'}`);
        }
      } catch (error) {
        alert('Failed to invite member');
      }
    });
    
    loadAuth();
    loadApiKeys();
    loadTeam();
  </script>

  <style>
    .main { min-height: 100vh; }
    
    .dashboard-header {
      background: #1f2937;
      color: white;
      padding: 1.5rem 2rem;
    }
    
    .header-content {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .dashboard-header h1 { margin: 0; font-size: 1.5rem; }
    
    .user-menu { display: flex; align-items: center; gap: 1rem; }
    .user-email { color: #9ca3af; font-size: 0.875rem; }
    
    .prefs-link {
      color: #93c5fd;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .prefs-link:hover { text-decoration: underline; }
    
    .logout-btn {
      background: #ef4444;
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      cursor: pointer;
    }
    
    .dashboard-grid {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 1.5rem;
    }
    
    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1.5rem;
    }
    
    .card h2 { margin: 0 0 1rem; font-size: 1.125rem; color: #1f2937; }
    
    .tier-badge {
      display: inline-block;
      padding: 0.375rem 0.875rem;
      border-radius: 9999px;
      font-weight: 600;
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
    }
    
    .tier-badge.free { background: #f3f4f6; color: #374151; }
    .tier-badge.pro { background: #dbeafe; color: #1e40af; }
    .tier-badge.team { background: #fef3c7; color: #92400e; }
    
    .status { color: #6b7280; font-size: 0.875rem; margin-bottom: 1rem; }
    
    .limits { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem; }
    .limit-item { display: flex; flex-direction: column; gap: 0.25rem; }
    .limit-label { font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; }
    .limit-value { font-weight: 600; color: #1f2937; }
    
    .upgrade-btn {
      width: 100%;
      padding: 0.75rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      display: none;
    }
    
    .usage-bar {
      height: 8px;
      background: #e5e7eb;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }
    
    .usage-fill {
      height: 100%;
      background: linear-gradient(90deg, #f59e0b, #ef4444);
      border-radius: 4px;
      transition: width 0.3s;
    }
    
    .usage-stats { font-weight: 600; color: #1f2937; }
    .reset-info { font-size: 0.75rem; color: #9ca3af; margin-top: 0.5rem; }
    
    @media (max-width: 768px) {
      .dashboard-grid { grid-template-columns: 1fr; }
      .header-content { flex-direction: column; gap: 1rem; text-align: center; }
    }
    
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    
    .btn-sm {
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
    }
    
    .api-keys-list, .team-members-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .api-key-item, .team-member-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    
    .api-key-info, .team-member-info {
      flex: 1;
      min-width: 0;
    }
    
    .api-key-name, .team-member-email {
      font-weight: 500;
      color: #1f2937;
      margin-bottom: 0.25rem;
    }
    
    .api-key-meta, .team-member-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      font-size: 0.75rem;
      color: #6b7280;
    }
    
    .api-key-prefix {
      font-family: monospace;
      background: #e5e7eb;
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
    }
    
    .team-member-role {
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      font-weight: 500;
      text-transform: capitalize;
    }
    
    .role-admin { background: #fef3c7; color: #92400e; }
    .role-member { background: #dbeafe; color: #1e40af; }
    .role-owner { background: #f3f4f6; color: #374151; }
    
    .team-member-status {
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      font-weight: 500;
      text-transform: capitalize;
      font-size: 0.7rem;
    }
    
    .status-active { background: #dcfce7; color: #166534; }
    .status-pending { background: #fef3c7; color: #92400e; }
    .status-rejected { background: #fee2e2; color: #991b1b; }
    
    .team-member-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    
    .role-select {
      padding: 0.25rem 0.5rem;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      font-size: 0.75rem;
      background: white;
    }
    
    .empty-state, .loading {
      text-align: center;
      color: #9ca3af;
      padding: 2rem;
      font-size: 0.875rem;
    }
    
    .btn-danger {
      background: #ef4444;
      color: white;
      border: none;
    }
    .btn-danger:hover { background: #dc2626; }
  </style>
</Layout>