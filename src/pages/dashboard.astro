---
import Layout from '../layouts/Layout.astro';
import '../styles/components.css';
---

<Layout title="Dashboard - FOVIQ Tools">
  <main class="main" id="main-content">
    <header class="dashboard-header" data-theme="hero">
      <div class="header-content">
        <div class="header-left">
          <a href="/" class="logo">
            <img src="/favicon.svg" alt="" width="24" height="24" />
            <span>FOVIQ Tools</span>
          </a>
          <h1>Dashboard</h1>
        </div>
        <div class="user-menu">
          <span id="user-email" class="user-email"></span>
          <a href="/email-prefs" class="btn btn-ghost btn-sm">Email Preferences</a>
          <button id="logout-btn" class="btn btn-secondary btn-sm">Logout</button>
        </div>
      </div>
    </header>

    <div class="dashboard-grid">
      <section class="card subscription-card">
        <h2>Subscription</h2>
        <span class="badge" data-tone="brand" id="tier-badge">Free</span>
        <p id="subscription-status" class="status">Active</p>
        <div class="limits" id="limits">
          <div class="limit-item">
            <span class="limit-label">Scans/month</span>
            <span class="limit-value" id="scans-limit">3</span>
          </div>
          <div class="limit-item">
            <span class="limit-label">Max file size</span>
            <span class="limit-value" id="file-size-limit">5 MB</span>
          </div>
          <div class="limit-item">
            <span class="limit-label">Diff checker</span>
            <span class="limit-value" id="diff-checker">No</span>
          </div>
          <div class="limit-item">
            <span class="limit-label">PDF export</span>
            <span class="limit-value" id="pdf-export">No</span>
          </div>
        </div>
        <button id="upgrade-btn" class="btn btn-primary upgrade-btn">Upgrade to Pro</button>
      </section>

      <section class="card usage-card">
        <h2>Usage This Month</h2>
        <div class="usage-bar">
          <div class="usage-fill" id="usage-fill" style="width: 0%"></div>
        </div>
        <div class="usage-stats">
          <span id="scans-used">0</span> / <span id="scans-remaining">3</span> scans used
        </div>
        <p class="reset-info">Resets on the 1st of each month</p>
      </section>

      <section class="card analyzer-card">
        <h2>Spreadsheet Analyzer</h2>
        <p>Upload a spreadsheet to check its health</p>
        <div id="analyzer-container"></div>
      </section>

      <section class="card api-keys-card" id="api-keys-card" style="display: none;">
        <div class="card-header">
          <h2>API Keys</h2>
          <button id="create-api-key-btn" class="btn btn-primary btn-sm">Create Key</button>
        </div>
        <div id="create-api-key-form" class="inline-form hidden">
          <input type="text" id="new-api-key-name" placeholder="Key name (e.g. Production)" />
          <button id="submit-api-key-btn" class="btn btn-primary btn-sm" type="button">Create</button>
          <button id="cancel-api-key-btn" class="btn btn-secondary btn-sm" type="button">Cancel</button>
        </div>
        <div id="api-key-reveal" class="key-reveal hidden">
          <p class="key-reveal-warning"><span aria-hidden="true">⚠️</span> Save this key now — you won't see it again.</p>
          <div class="key-reveal-row">
            <input type="text" id="api-key-value" class="key-reveal-input" readonly />
            <button id="copy-api-key-btn" class="key-reveal-copy-btn" type="button">Copy</button>
          </div>
        </div>
        <div id="api-key-status" class="status-message hidden"></div>
        <div id="api-keys-list" class="api-keys-list">
          <p class="loading">Loading...</p>
        </div>
      </section>

      <section class="card team-card" id="team-card" style="display: none;">
        <div class="card-header">
          <h2>Team Members</h2>
          <button id="invite-member-btn" class="btn btn-primary btn-sm">Invite Member</button>
        </div>
        <div id="invite-member-form" class="inline-form hidden">
          <input type="email" id="invite-member-email" placeholder="teammate@company.com" />
          <select id="invite-member-role">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
          <button id="submit-invite-btn" class="btn btn-primary btn-sm" type="button">Send Invite</button>
          <button id="cancel-invite-btn" class="btn btn-secondary btn-sm" type="button">Cancel</button>
        </div>
        <div id="invite-status" class="status-message hidden"></div>
        <div id="team-members-list" class="team-members-list">
          <p class="loading">Loading...</p>
        </div>
      </section>
    </div>
  </main>

  <div id="upgrade-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <svg class="modal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <h3>Upgrade to Pro</h3>
      <p>We're finishing up billing so you can upgrade in-app. In the meantime, reach out and we'll get you set up directly.</p>
      <div class="modal-actions">
        <button id="upgrade-modal-close" class="modal-close-btn" type="button">Maybe Later</button>
      </div>
    </div>
  </div>

  <div id="confirm-modal" class="modal-overlay hidden" role="alertdialog" aria-modal="true" aria-labelledby="confirm-modal-title">
    <div class="modal-card">
      <svg class="modal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 9v4" />
        <path d="M12 17h.01" />
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
      </svg>
      <h3 id="confirm-modal-title">Are you sure?</h3>
      <p id="confirm-modal-message"></p>
      <div class="modal-actions">
        <button id="confirm-modal-cancel" class="modal-close-btn" type="button">Cancel</button>
        <button id="confirm-modal-confirm" class="btn btn-danger-solid" type="button">Confirm</button>
      </div>
    </div>
  </div>

  <script>
    async function loadAuth() {
      try {
        const res = await fetch('/api/auth/me', { credentials: 'include' });
        const data = await res.json();
        
        if (!data.user) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('user-email')!.textContent = data.user.email;
        document.getElementById('tier-badge')!.textContent = data.subscription.tier.charAt(0).toUpperCase() + data.subscription.tier.slice(1);
        document.getElementById('subscription-status')!.textContent = data.subscription.status;
        document.getElementById('scans-limit')!.textContent = data.limits.scansPerMonth === -1 ? 'Unlimited' : data.limits.scansPerMonth;
        document.getElementById('file-size-limit')!.textContent = data.limits.maxFileSizeMB + ' MB';
        document.getElementById('diff-checker')!.textContent = data.limits.diffChecker ? 'Yes' : 'No';
        document.getElementById('pdf-export')!.textContent = data.limits.pdfExport ? 'Yes' : 'No';
        
        const used = data.usage.scansUsed;
        const limit = data.limits.scansPerMonth;
        const remaining = data.usage.scansRemaining;
        
        document.getElementById('scans-used')!.textContent = used;
        document.getElementById('scans-remaining')!.textContent = limit === -1 ? 'Unlimited' : remaining;
        
        if (limit !== -1) {
          const percent = (used / limit) * 100;
          document.getElementById('usage-fill')!.style.width = Math.min(100, percent) + '%';
        } else {
          document.getElementById('usage-fill')!.style.width = '0%';
          document.getElementById('usage-fill')!.style.background = 'linear-gradient(90deg, var(--color-success), var(--color-success-strong))';
        }
        
        if (data.subscription.tier === 'free') {
          document.getElementById('upgrade-btn')!.style.display = 'block';
        }
        
        loadAnalyzer(data.limits, data.usage.scansUsed, data.usage.scansRemaining);
      } catch (error) {
        console.error('Auth load failed:', error);
        window.location.href = '/login';
      }
    }
    
    function loadAnalyzer(limits: any, scansUsed: number, scansRemaining: number) {
      const container = document.getElementById('analyzer-container');
      if (!container) return;
      
      import('../components/Analyzer.tsx').then(module => {
        const Analyzer = module.default;
        const root = document.createElement('div');
        container.appendChild(root);
        
        if (window.React && window.ReactDOM) {
          window.ReactDOM.createRoot(root).render(window.React.createElement(Analyzer, { 
            limits, 
            scansUsed,
            scansRemaining,
            maxFileSize: limits.maxFileSizeMB * 1024 * 1024 
          }));
        }
      });
    }
    
    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      window.location.href = '/';
    });
    
    const upgradeModal = document.getElementById('upgrade-modal')!;
    document.getElementById('upgrade-btn')!.addEventListener('click', () => {
      upgradeModal.classList.remove('hidden');
    });
    document.getElementById('upgrade-modal-close')!.addEventListener('click', () => {
      upgradeModal.classList.add('hidden');
    });
    upgradeModal.addEventListener('click', (e) => {
      if (e.target === upgradeModal) upgradeModal.classList.add('hidden');
    });

    const confirmModal = document.getElementById('confirm-modal')!;
    const confirmModalMessage = document.getElementById('confirm-modal-message')!;
    const confirmModalConfirmBtn = document.getElementById('confirm-modal-confirm')!;
    const confirmModalCancelBtn = document.getElementById('confirm-modal-cancel')!;
    let lastFocusedBeforeConfirm: HTMLElement | null = null;

    function confirmDialog(message: string): Promise<boolean> {
      return new Promise((resolve) => {
        lastFocusedBeforeConfirm = document.activeElement as HTMLElement;
        confirmModalMessage.textContent = message;
        confirmModal.classList.remove('hidden');
        confirmModalConfirmBtn.focus();

        const cleanup = (result: boolean) => {
          confirmModal.classList.add('hidden');
          confirmModalConfirmBtn.removeEventListener('click', onConfirm);
          confirmModalCancelBtn.removeEventListener('click', onCancel);
          confirmModal.removeEventListener('click', onOverlayClick);
          lastFocusedBeforeConfirm?.focus();
          resolve(result);
        };
        const onConfirm = () => cleanup(true);
        const onCancel = () => cleanup(false);
        const onOverlayClick = (e: MouseEvent) => { if (e.target === confirmModal) cleanup(false); };

        confirmModalConfirmBtn.addEventListener('click', onConfirm);
        confirmModalCancelBtn.addEventListener('click', onCancel);
        confirmModal.addEventListener('click', onOverlayClick);
      });
    }

    loadAuth();
    
    async function loadApiKeys() {
      try {
        const res = await fetch('/api/api-keys', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        renderApiKeys(data.keys);
      } catch (error) {
        console.error('Failed to load API keys:', error);
      }
    }
    
    function renderApiKeys(keys: any[]) {
      const list = document.getElementById('api-keys-list');
      const card = document.getElementById('api-keys-card');
      
      if (!card) return;
      
      card.style.display = 'block';
      
      if (!keys || keys.length === 0) {
        list.innerHTML = `
          <p class="empty-state">No API keys yet. Create one to access the API.</p>
        `;
        return;
      }
      
      list.innerHTML = keys.map(key => `
        <div class="api-key-item">
          <div class="api-key-info">
            <div class="api-key-name">${key.name}</div>
            <div class="api-key-meta">
              <span class="api-key-prefix">${key.prefix}...</span>
              <span class="api-key-rate-limit">${key.rateLimit} req/min</span>
              <span class="api-key-created">Created ${new Date(key.createdAt).toLocaleDateString()}</span>
            </div>
          </div>
          <button class="btn btn-danger btn-sm delete-key-btn" data-key-id="${key.id}">Delete</button>
        </div>
      `).join('');
      
      list.querySelectorAll('.delete-key-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const keyId = (e.target as HTMLButtonElement).dataset.keyId;
          if (await confirmDialog('Delete this API key? This cannot be undone.')) {
            await fetch(`/api/api-keys/${keyId}`, { 
              method: 'DELETE', 
              credentials: 'include' 
            });
            loadApiKeys();
          }
        });
      });
    }
    
    async function loadTeam() {
      try {
        const res = await fetch('/api/teams', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        renderTeam(data);
      } catch (error) {
        console.error('Failed to load team:', error);
      }
    }
    
    function renderTeam(data: any) {
      const list = document.getElementById('team-members-list');
      const card = document.getElementById('team-card');
      
      if (!card) return;
      
      if (!data.team) {
        card.style.display = 'none';
        return;
      }
      
      card.style.display = 'block';
      card.querySelector('h2')!.textContent = `Team (${data.team.role === 'owner' ? 'Owner' : data.team.role === 'admin' ? 'Admin' : 'Member'})`;
      
      if (!data.members || data.members.length === 0) {
        list.innerHTML = '<p class="empty-state">No team members yet.</p>';
        return;
      }
      
      list.innerHTML = data.members.map((member: any) => `
        <div class="team-member-item">
          <div class="team-member-info">
            <div class="team-member-email">${member.email}</div>
            <div class="team-member-meta">
              <span class="team-member-role role-${member.role}">${member.role}</span>
              <span class="team-member-status status-${member.status}">${member.status}</span>
              ${member.acceptedAt ? `<span>Joined ${new Date(member.acceptedAt).toLocaleDateString()}</span>` : '<span>Invited</span>'}
            </div>
          </div>
          <div class="team-member-actions">
            ${data.team.role === 'owner' && member.status === 'active' && member.userId ? `
              <select class="role-select" data-member-id="${member.id}">
                <option value="admin" ${member.role === 'admin' ? 'selected' : ''}>Admin</option>
                <option value="member" ${member.role === 'member' ? 'selected' : ''}>Member</option>
              </select>
              <button class="btn btn-danger btn-sm remove-member-btn" data-member-id="${member.id}">Remove</button>
            ` : ''}
          </div>
        </div>
      `).join('');
      
      list.querySelectorAll('.role-select').forEach(select => {
        select.addEventListener('change', async (e) => {
          const memberId = (e.target as HTMLSelectElement).dataset.memberId;
          const role = (e.target as HTMLSelectElement).value;
          await fetch(`/api/teams/${memberId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ role }),
          });
          loadTeam();
        });
      });
      
      list.querySelectorAll('.remove-member-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const memberId = (e.target as HTMLButtonElement).dataset.memberId;
          if (await confirmDialog('Remove this team member?')) {
            await fetch(`/api/teams/${memberId}`, { 
              method: 'DELETE', 
              credentials: 'include' 
            });
            loadTeam();
          }
        });
      });
    }
    
    function showStatus(el: HTMLElement, message: string, type: 'success' | 'error') {
      el.textContent = message;
      el.className = `status-message ${type}`;
    }

    const createApiKeyForm = document.getElementById('create-api-key-form')!;
    const newApiKeyNameInput = document.getElementById('new-api-key-name') as HTMLInputElement;
    const apiKeyReveal = document.getElementById('api-key-reveal')!;
    const apiKeyValueInput = document.getElementById('api-key-value') as HTMLInputElement;
    const apiKeyStatus = document.getElementById('api-key-status')!;

    document.getElementById('create-api-key-btn')!.addEventListener('click', () => {
      apiKeyReveal.classList.add('hidden');
      apiKeyStatus.classList.add('hidden');
      createApiKeyForm.classList.remove('hidden');
      newApiKeyNameInput.value = '';
      newApiKeyNameInput.focus();
    });

    document.getElementById('cancel-api-key-btn')!.addEventListener('click', () => {
      createApiKeyForm.classList.add('hidden');
    });

    document.getElementById('submit-api-key-btn')!.addEventListener('click', async () => {
      const name = newApiKeyNameInput.value.trim();
      if (!name) {
        apiKeyStatus.classList.remove('hidden');
        showStatus(apiKeyStatus, 'Enter a name for this key.', 'error');
        return;
      }

      try {
        const res = await fetch('/api/api-keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ name }),
        });

        const data = await res.json();
        if (res.ok) {
          createApiKeyForm.classList.add('hidden');
          apiKeyStatus.classList.add('hidden');
          apiKeyValueInput.value = data.key;
          apiKeyReveal.classList.remove('hidden');
          loadApiKeys();
        } else {
          apiKeyStatus.classList.remove('hidden');
          showStatus(apiKeyStatus, data.error || 'Failed to create key', 'error');
        }
      } catch (error) {
        apiKeyStatus.classList.remove('hidden');
        showStatus(apiKeyStatus, 'Failed to create API key', 'error');
      }
    });

    document.getElementById('copy-api-key-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('copy-api-key-btn')!;
      try {
        await navigator.clipboard.writeText(apiKeyValueInput.value);
      } catch {
        apiKeyValueInput.select();
      }
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
    
    const inviteMemberForm = document.getElementById('invite-member-form')!;
    const inviteMemberEmailInput = document.getElementById('invite-member-email') as HTMLInputElement;
    const inviteMemberRoleSelect = document.getElementById('invite-member-role') as HTMLSelectElement;
    const inviteStatus = document.getElementById('invite-status')!;

    document.getElementById('invite-member-btn')!.addEventListener('click', () => {
      inviteStatus.classList.add('hidden');
      inviteMemberForm.classList.remove('hidden');
      inviteMemberEmailInput.value = '';
      inviteMemberEmailInput.focus();
    });

    document.getElementById('cancel-invite-btn')!.addEventListener('click', () => {
      inviteMemberForm.classList.add('hidden');
    });

    document.getElementById('submit-invite-btn')!.addEventListener('click', async () => {
      const email = inviteMemberEmailInput.value.trim();
      if (!email) {
        inviteStatus.classList.remove('hidden');
        showStatus(inviteStatus, 'Enter an email address.', 'error');
        return;
      }

      const role = inviteMemberRoleSelect.value;

      try {
        const res = await fetch('/api/teams', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email, role }),
        });

        const data = await res.json();
        inviteStatus.classList.remove('hidden');
        if (res.ok) {
          inviteMemberForm.classList.add('hidden');
          showStatus(inviteStatus, `Invitation sent to ${email}.`, 'success');
          loadTeam();
        } else {
          showStatus(inviteStatus, data.error || 'Failed to invite', 'error');
        }
      } catch (error) {
        inviteStatus.classList.remove('hidden');
        showStatus(inviteStatus, 'Failed to invite member', 'error');
      }
    });
    
    loadAuth();
    loadApiKeys();
    loadTeam();
  </script>

  <style>
    .main { min-height: 100vh; }

    .dashboard-header {
      background: var(--gray-900);
      color: white;
      padding: var(--space-6) var(--space-8);
    }

    .header-content {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .dashboard-header h1 {
      margin: 0;
      padding-left: var(--space-4);
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      font-size: var(--text-xl);
      font-weight: 700;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: white;
      font-size: var(--text-sm);
      font-weight: 700;
      text-decoration: none;
    }

    .logo img { border-radius: var(--radius-sm); }

    .user-menu { display: flex; align-items: center; gap: var(--space-3); }
    .user-email { color: rgba(255, 255, 255, 0.65); font-size: var(--text-sm); }

    .dashboard-grid {
      max-width: 1200px;
      margin: var(--space-8) auto;
      padding: 0 var(--space-6);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
    }

    .card { padding: var(--space-6); }

    .card h2 { margin: 0 0 var(--space-4); font-size: var(--text-lg); color: var(--color-text); }

    #tier-badge { margin-bottom: var(--space-2); }

    .status { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: var(--space-4); }

    .limits { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-4); }
    .limit-item { display: flex; flex-direction: column; gap: 0.25rem; }
    .limit-label { font-size: var(--text-xs); color: var(--color-text-faint); text-transform: uppercase; letter-spacing: 0.05em; }
    .limit-value { font-weight: 600; color: var(--color-text); }

    .upgrade-btn {
      width: 100%;
      margin-top: var(--space-2);
      display: none;
    }

    .usage-bar {
      height: 8px;
      background: var(--color-border);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }
    
    .usage-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--color-warning), var(--color-danger));
      border-radius: 4px;
      transition: width 0.3s;
    }
    
    .usage-stats { font-weight: 600; color: var(--color-text); }
    .reset-info { font-size: 0.75rem; color: var(--color-text-faint); margin-top: 0.5rem; }
    
    @media (max-width: 1024px) {
      .dashboard-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; padding: 0 1.25rem; }
    }

    @media (max-width: 768px) {
      .dashboard-grid { grid-template-columns: 1fr; }
      .header-content { flex-direction: column; gap: 1rem; text-align: center; }
    }
    
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .api-keys-list, .team-members-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .api-key-item, .team-member-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: var(--color-bg-subtle);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }
    
    .api-key-info, .team-member-info {
      flex: 1;
      min-width: 0;
    }
    
    .api-key-name, .team-member-email {
      font-weight: 500;
      color: var(--color-text);
      margin-bottom: 0.25rem;
    }
    
    .api-key-meta, .team-member-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }
    
    .api-key-prefix {
      font-family: monospace;
      background: var(--color-border);
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
    }
    
    .team-member-role {
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      font-weight: 500;
      text-transform: capitalize;
    }
    
