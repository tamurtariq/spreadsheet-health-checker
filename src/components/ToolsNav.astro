---
interface Props {
  theme?: 'hero' | 'light';
  logoText?: string;
}

const { theme = 'light', logoText = 'FOVIQ Tools' } = Astro.props;

const TOOLS = [
  { href: '/', label: 'Health Checker' },
  { href: '/diff', label: 'Diff Checker' },
  { href: '/lead-csv-cleaner', label: 'Lead CSV Cleaner' },
];

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
---

<nav class="nav-bar" data-theme={theme}>
  <a href="/" class="logo">{logoText}</a>
  <div class="tools-links">
    {TOOLS.map(tool => (
      <a
        href={tool.href}
        class:list={['tools-link', { active: normalize(tool.href) === currentPath }]}
      >
        {tool.label}
      </a>
    ))}
  </div>
  <div id="nav-auth" class="nav-auth">
    <a href="/login" class="btn btn-secondary">Sign In</a>
    <a href="/login" class="btn btn-primary">Get Started Free</a>
  </div>
</nav>

<script>
  async function loadAuth() {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'include' });
      const data = await res.json();
      const navAuth = document.getElementById('nav-auth');

      if (data.user) {
        navAuth.innerHTML = `
          <div class="user-menu">
            <span class="user-email">${data.user.email}</span>
            <a href="/dashboard" class="btn btn-primary">Dashboard</a>
            <button id="logout-btn" class="btn btn-secondary btn-logout">Logout</button>
          </div>
        `;
        document.getElementById('logout-btn')?.addEventListener('click', async () => {
          await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
          window.location.reload();
        });
      }
    } catch (error) {
      console.error('Auth check failed:', error);
    }
  }
  loadAuth();
</script>

<style>
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .nav-auth { display: flex; gap: 0.75rem; }

  .tools-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .tools-link {
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .tools-link:hover { opacity: 1; }
  .tools-link.active { opacity: 1; font-weight: 700; }

  .btn {
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .user-menu { display: flex; align-items: center; gap: 1rem; }

  /* hero theme: white text/buttons on a dark gradient header (homepage) */
  .nav-bar[data-theme='hero'] .logo {
    color: white;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }
  .nav-bar[data-theme='hero'] .tools-link { color: white; }
  .nav-bar[data-theme='hero'] .btn-primary { background: white; color: #667eea; }
  .nav-bar[data-theme='hero'] .btn-primary:hover { background: #f3f4f6; }
  .nav-bar[data-theme='hero'] .btn-secondary {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .nav-bar[data-theme='hero'] .btn-secondary:hover { background: rgba(255, 255, 255, 0.3); }
  .nav-bar[data-theme='hero'] .user-email { color: rgba(255, 255, 255, 0.8); font-size: 0.875rem; }
  .nav-bar[data-theme='hero'] .btn-logout {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.875rem;
  }
  .nav-bar[data-theme='hero'] .btn-logout:hover { background: rgba(255, 255, 255, 0.3); }

  /* light theme: dark text on a white header (diff checker, other tool pages) */
  .nav-bar[data-theme='light'] .logo {
    color: #1f2937;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }
  .nav-bar[data-theme='light'] .tools-link { color: #374151; }
  .nav-bar[data-theme='light'] .btn-primary { background: #667eea; color: white; }
  .nav-bar[data-theme='light'] .btn-primary:hover { background: #5a6fd6; }
  .nav-bar[data-theme='light'] .btn-secondary {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #e5e7eb;
  }
  .nav-bar[data-theme='light'] .btn-secondary:hover { background: #e5e7eb; }
  .nav-bar[data-theme='light'] .user-email { color: #6b7280; font-size: 0.875rem; }
  .nav-bar[data-theme='light'] .btn-logout {
    background: #fef2f2;
    color: #ef4444;
    border: 1px solid #fecaca;
  }
  .nav-bar[data-theme='light'] .btn-logout:hover { background: #fee2e2; }

  @media (max-width: 768px) {
    .nav-bar { flex-direction: column; gap: 1rem; }
  }
</style>
